# Copy to .env and replace values. Never commit real secrets.

# Runtime
APP_ENV=development
APP_NAME=Flight Hunter
APP_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000
DEFAULT_LOCALE=ru
DEFAULT_TIMEZONE=Europe/Warsaw
DEFAULT_CURRENCY=PLN
LOG_LEVEL=INFO

# Security
APP_SECRET_KEY=
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SESSION_COOKIE_SECURE=false
INVITATION_ONLY=true
AUTH_BOOTSTRAP_TOKEN=
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_ALLOW_LEGACY_HEADERS=false
AUTH_LOCAL_AUTO_LOGIN=true
OWNER_BOOTSTRAP_EMAIL=owner@example.com

# Local v1 storage. PostgreSQL values below are reserved for a future deployment target.
DATABASE_URL=sqlite+aiosqlite:///./flight_hunter_dev.db

# Optional future PostgreSQL/PostGIS target (unused by local v1)
POSTGRES_DB=flight_hunter
POSTGRES_USER=flight_hunter
POSTGRES_PASSWORD=replace-me

# Redis / workers
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=4
SCHEDULER_ENABLED=true

# Durable watch scans. The worker only calls providers whose policy allows background requests.
WATCH_SCAN_ENABLED=true
WATCH_SCAN_INTERVAL_SECONDS=21600
WATCH_SCAN_JOB_DEADLINE_SECONDS=300
WATCH_ALERT_DROP_THRESHOLD_PERCENT=10
WATCH_ALERT_COOLDOWN_SECONDS=21600

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TRANSPORT=webhook
TELEGRAM_FAKE_SINK=true
TELEGRAM_QUIET_HOURS_START=23:00
TELEGRAM_QUIET_HOURS_END=08:00
TELEGRAM_WATCH_CHECK_SOURCE_ID=tutu

# LLM is optional; core product must work without it
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_COST_PER_REQUEST=

# Agent mode / presets
AGENT_MODE_ENABLED=true
AGENT_PROVIDER=deterministic_presets
AGENT_MCP_ENABLED=false
AGENT_MCP_SERVER=
AGENT_CODEX_CLI_ENABLED=false
AGENT_CODEX_CLI_MODEL=gpt-5.4-mini
AGENT_CODEX_CLI_TIMEOUT_SECONDS=15
AGENT_CODEX_CLI_SERVICE_TIER=fast
AGENT_CODEX_CLI_MAX_OUTPUT_BYTES=16384
AGENT_OPENAI_ENABLED=false
AGENT_OPENAI_MODEL=gpt-5.5
AGENT_OPENAI_TIMEOUT_SECONDS=8
AGENT_PLAN_TTL_SECONDS=86400
AGENT_QUICK_LOGICAL_LIMIT=60
AGENT_QUICK_CALENDAR_LIMIT=40
AGENT_QUICK_EXACT_LIMIT=20
AGENT_FULL_LOGICAL_LIMIT=240
AGENT_ABSOLUTE_LOGICAL_LIMIT=1000
AGENT_QUICK_DEADLINE_SECONDS=600
AGENT_FULL_DEADLINE_SECONDS=1800
AGENT_OPERATION_LEASE_SECONDS=120
AGENT_POLL_INTERVAL_SECONDS=2
AGENT_MAX_LAYOVER_SECONDS=64800
AGENT_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
AGENT_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=120
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Live refresh safety
LIVE_REFRESH_MIN_GAP_SECONDS=600

# Risky price observer. Keep off until each source is checked and explicitly approved.
SCRAPING_OBSERVER_ENABLED=false
SCRAPING_MIN_GAP_SECONDS=600

# Personal browser observer control plane. Disabled by default and never background-auto-runs.
PERSONAL_OBSERVER_ENABLED=false
PERSONAL_OBSERVER_HEADLESS=false
PERSONAL_OBSERVER_PROFILE_ROOT=.local/browser-profiles
PERSONAL_OBSERVER_ARTIFACT_ROOT=.local/browser-artifacts
PERSONAL_OBSERVER_SAVE_DOM_FIXTURES=false
PERSONAL_OBSERVER_SAVE_SCREENSHOTS=false
PERSONAL_OBSERVER_SAVE_RUNTIME_MANIFESTS=false
PERSONAL_OBSERVER_PROFILE_LOCK_TIMEOUT_SECONDS=0
PERSONAL_OBSERVER_PROFILE_LOCK_STALE_SECONDS=3600
PERSONAL_OBSERVER_NAVIGATION_TIMEOUT_MS=45000
PERSONAL_OBSERVER_READY_SELECTOR=
PERSONAL_OBSERVER_READY_TIMEOUT_MS=15000
PERSONAL_OBSERVER_WAIT_FOR_NETWORK_IDLE=false
PERSONAL_OBSERVER_MANUAL_CHECKPOINT_SECONDS=0
PERSONAL_OBSERVER_MAX_CONCURRENT=1
PERSONAL_OBSERVER_MIN_GAP_SECONDS=60
PERSONAL_OBSERVER_RESULT_TTL_SECONDS=300
PERSONAL_OBSERVER_ALLOWED_HOSTS=aviasales.ru,www.aviasales.ru,travel.yandex.ru,www.tutu.ru,avia.tutu.ru,www.onetwotrip.com
PERSONAL_OBSERVER_REQUIRE_USER_ACTION=true
PERSONAL_OBSERVER_AUTO_RUN=false

# Optional extraction/search helper libraries. They do not run without the observer policy gates.
SCRAPLING_ENABLED=true
SCRAPLING_ADAPTIVE_STORAGE=.local/scrapling-adaptive
SCRAPLING_USE_FETCHERS=false
SCRAPLING_USE_SPIDERS=false
CRAWL4AI_ENABLED=false
# App default is library mode; Docker Compose deal-discovery profile defaults to server mode.
CRAWL4AI_MODE=library
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=
CRAWL4AI_TIMEOUT_SECONDS=30
CRAWL4AI_CACHE_DIR=.local/crawl4ai-cache
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.8.9
SEARXNG_ENABLED=false
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_IMAGE=searxng/searxng:2026.6.29-0e990f78a
SEARXNG_FORMAT=json
SEARXNG_TIMEOUT_SECONDS=15
DEAL_CANDIDATE_TTL_SECONDS=86400
DEAL_DISCOVERY_JOB_DEADLINE_SECONDS=600
# Optional comma-separated exact hosts or wildcard subdomains like *.example.com.
# Empty means any public http/https URL that passes the SSRF URL policy.
DEAL_DISCOVERY_ALLOWED_HOSTS=

# External check links shown separately from priced offers.
RU_AGGREGATORS_ENABLED=aviasales_clickout,yandex_travel,tutu,onetwotrip
CARRIER_LINKS_ENABLED=aeroflot,pobeda,s7,ural_airlines,nordwind,red_wings,smartavia,azimuth,utair,rossiya,turkish_airlines,air_serbia,pegasus,uzbekistan_airways,emirates,qatar_airways,etihad,flydubai
SOURCE_INTERNAL_RPM=10

# Aviasales Search — live mobile API (local hobby project, used directly).
# Signature and marker come from the decompiled APK protocol; see
# docs/provider-contracts/aviasales-search.md. No partner access required.
# Import a local kit without printing values: flight-hunter-import-api-kit.
AVIASALES_SEARCH_ENABLED=false
AVIASALES_SEARCH_SIGNATURE=
AVIASALES_SEARCH_MARKER=
AVIASALES_SEARCH_INTERNAL_RPM=20

# Skyscanner — keep disabled until partnership approval
SKYSCANNER_INDICATIVE_ENABLED=false
SKYSCANNER_LIVE_ENABLED=false
SKYSCANNER_ACCESS_APPROVED=false
SKYSCANNER_API_KEY=

# Duffel
DUFFEL_ENABLED=false
DUFFEL_MODE=test
DUFFEL_ACCESS_TOKEN=
DUFFEL_BACKGROUND_POLLING_ALLOWED=false

# Amadeus legacy/enterprise only
AMADEUS_ENABLED=false
AMADEUS_ACCESS_MODE=disabled
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BACKGROUND_POLLING_ALLOWED=false

# Feature flags
FEATURE_SPLIT_TICKETS=true
FEATURE_SELF_TRANSFER=true
FEATURE_HIDDEN_CITY_RESEARCH=false
FEATURE_DEAL_FEEDS=true
FEATURE_HOT_DEAL_SCANNER=true
FEATURE_PWA=true

# Airport/reference data
OURAIRPORTS_IMPORT_ENABLED=true
OURAIRPORTS_IMPORT_SCHEDULE=0 3 * * *
NEARBY_AIRPORT_DEFAULT_RADIUS_KM=150
NEARBY_AIRPORT_MAX_RADIUS_KM=300

# FX / cost model
FX_PROVIDER=ecb_or_configured
DEFAULT_CARD_FX_FEE_PERCENT=0
GROUND_TRANSFER_ESTIMATES_ENABLED=true

# Storage / retention
RAW_PROVIDER_PAYLOAD_RETENTION_DAYS=0
PRICE_HISTORY_RETENTION_DAYS=0
AUDIT_LOG_RETENTION_DAYS=365
OBJECT_STORAGE_ENABLED=false
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# Backups
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_KEY=
